# data-graph.ttl — the evaluation lineage of every published output.
#
# One node per artefact in the I/T/O/S notation defined in paper 1's
# Terminology and used in its table captions:
#
#   I = (D, P)        an input: a corpus D crossed with a parameter class P,
#                     P being a base plus overrides joined by `·`
#   T                 a transformer: the model (F1-F4, F_base) or an estimator.
#                     T is the CLASS; F1-F4/F_base are the named instances.
#   O = T(I) | σ      an output: PER RIDE, one row per ride, σ the inclusion
#                     rule.  The transformer preserves ride grain but NOT
#                     population.  Every :cardinality below is COUNTED from the
#                     CSV, never asserted.
#
# CAUTION on |O| vs |D|: `|O| <= |D|` holds only against the RAW deposit. Paper
# 1's Table 1 reports each corpus at its CLEAN count, which is already
# post-selection — so a CSV can be WIDER than its own published |D| (censo 69
# rows for 62; D5 636 for 621) without any inequality being violated. The full
# D5 funnel is 3,219 export files -> 636 scored -> 621 clean = the published
# |D|. Compare an output against the stage it was actually drawn from.
#   S(O)              a statistic: the medians, CIs and figures the article and
#                     journal actually print, and what bootstrap_ci.py re-derives.
#
# Why the graph exists: the notation's whole job is to keep a population from
# being read as its superset. The one published error it was designed around
# was exactly an |O| vs |D| confusion — a scope claim whose denominator was all
# 2,155 ride-evaluations when its O covered Table 3's corpora only (1,366).
# Reading a denominator off this graph is therefore a check, not a courtesy.
#
# Direction: every edge points BACKWARD to what a thing was made from
# (prov:wasDerivedFrom / prov:wasGeneratedBy / prov:used), so the graph is a DAG
# rooted at the corpora and read leaf-first from any published number.
#
# Stack: widely-used vocabularies — PROV-O (entities, activities, derivation),
# P-Plan (the harness as a plan), Dublin Core, schema.org. The five terms in the
# local namespace (:Dataset :ParameterClass :Transformer :Output :Statistic and
# their properties) are the I/T/O/S notation itself, which has no standard
# equivalent; everything else is reused.
#
# Sibling graph: research/notes/claims.ttl holds the claims-questions-evidence
# layer. This file is its data-lineage complement — claims.ttl says what was
# argued, this says what it was computed from.
#
# Validate: python3 -c "import rdflib; g=rdflib.Graph().parse('research/data-graph.ttl'); print(len(g))"

@prefix :        <https://danlessa.github.io/bicycling-energy-model/data-graph#> .
@prefix claims:  <https://danlessa.github.io/bicycling-energy-model/claims#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix p-plan:  <http://purl.org/net/p-plan#> .
@prefix schema:  <http://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

<https://danlessa.github.io/bicycling-energy-model/data-graph>
    a prov:Bundle, schema:Dataset ;
    dcterms:title "Evaluation lineage (I/T/O/S) for the bicycling energy model" ;
    dcterms:creator "Danilo Lessa Bernardineli" ;
    dcterms:modified "2026-08-08"^^xsd:date ;
    dcterms:description "Corpora, parameter classes, transformers, per-ride outputs and the published statistics derived from them." ;
    rdfs:seeAlso <https://danlessa.github.io/bicycling-energy-model/claims> .

# ---------------------------------------------------------------------------
# The notation itself
# ---------------------------------------------------------------------------

:Dataset        a owl:Class ; rdfs:subClassOf prov:Entity ;
    rdfs:label "D — corpus" ;
    rdfs:comment "A body of rides. Cardinality is the CLEAN ride count; an output built from it is almost always smaller." .

:ParameterClass a owl:Class ; rdfs:subClassOf prov:Entity ;
    rdfs:label "P — parameter class" ;
    rdfs:comment "How the physical constants were obtained: assumed (a) or fitted (f), globally (g), per ride (r) or per person (p)." .

:Transformer    a owl:Class ; rdfs:subClassOf p-plan:Plan ;
    rdfs:label "T — transformer (instances: F1-F4, F_base, estimators)" ;
    rdfs:comment "A model form or an estimator: consumes an I, emits one row per surviving ride." .

:Model          a owl:Class ; rdfs:subClassOf :Transformer ;
    rdfs:comment "A transformer that predicts ride energy: F1-F4 and F_base." .

:Estimator      a owl:Class ; rdfs:subClassOf :Transformer ;
    rdfs:comment "A transformer that measures a quantity from telemetry rather than predicting energy." .

:Input          a owl:Class ; rdfs:subClassOf prov:Entity ;
    rdfs:label "I = (D, P)" .

:Output         a owl:Class ; rdfs:subClassOf prov:Entity ;
    rdfs:label "O = T(I) | σ" ;
    rdfs:comment "Per-ride result table. ALWAYS carries :cardinality and :selection: the pair is what distinguishes O from D." .

:Statistic      a owl:Class ; rdfs:subClassOf prov:Entity ;
    rdfs:label "S(O)" ;
    rdfs:comment "A published aggregate — table cell, figure, headline median — with its bootstrap interval." .

:dataset        a owl:ObjectProperty ; rdfs:domain :Input ; rdfs:range :Dataset .
:parameters     a owl:ObjectProperty ; rdfs:domain :Input ; rdfs:range :ParameterClass .
:override       a owl:ObjectProperty ; rdfs:domain :Input ;
    rdfs:comment "The `·` operator: a parameter replaced relative to the base class." .
:transformer    a owl:ObjectProperty ; rdfs:domain :Output ; rdfs:range :Transformer .
:input          a owl:ObjectProperty ; rdfs:domain :Output ; rdfs:range :Input .
:selection      a owl:DatatypeProperty ; rdfs:domain :Output ;
    rdfs:label "σ — inclusion rule" .
:cardinality    a owl:DatatypeProperty ;
    rdfs:comment "|D| or |O|. On an Output this is COUNTED from the emitted CSV." .
:gatedBy        a owl:ObjectProperty ;
    rdfs:comment "The bootstrap_ci.py section that re-derives this statistic and fails the build if it moved." .
:epsilonForm    a owl:ObjectProperty ; rdfs:domain :Model .

# ---------------------------------------------------------------------------
# D — the corpora  (clean counts: paper 1, Table 1)
# ---------------------------------------------------------------------------

:D1 a :Dataset ; rdfs:label "D1 longões" ; :cardinality 44 ;
    dcterms:description "Long brevet-style rides, open terrain, the author. Calibration + primary comparison." ;
    rdfs:comment "Contained in D5 (Entry 52: 43% match on measured kJ; the rest are the same rider's rides under an older pipeline) — so D1, like D2, is NOT an independent check and is excluded from the Entry-52-onward evaluation population." ;
    schema:spatialCoverage "São Paulo metropolitan region and beyond" .

:D2 a :Dataset ; rdfs:label "D2 censo" ; :cardinality 62 ;
    dcterms:description "Urban stop-go group rides, generic rider assumed. Out-of-domain regime test." ;
    rdfs:comment "58 of its 62 rides are also in D5, re-evaluated as a generic rider — which is why D2 is excluded from the D3–D5 pool." ;
    schema:spatialCoverage "São Paulo" .

:D3 a :Dataset ; rdfs:label "D3 P. Paz" ; :cardinality 441 ;
    dcterms:description "Independent rider's full history, fast open-road. Frozen-constant transfer." ;
    dcterms:accessRights "private — shared with consent, never committed" .

:D4 a :Dataset ; rdfs:label "D4 JAAM" ; :cardinality 219 ;
    dcterms:description "Independent rider's full history, gentle terrain, strong descent-pedaller." ;
    dcterms:accessRights "private — shared with consent, never committed" .

:D5 a :Dataset ; rdfs:label "D5 author-full" ; :cardinality 621 ;
    dcterms:description "The author's complete history; superset of D1. Large-sample in-sample validation." .

:D6 a :Dataset ; rdfs:label "D6 scikit-cycling" ; :cardinality 740 ;
    dcterms:description "Four European riders (Catalonia, Burgundy, French Alps) from an open deposit. External transfer: no shared rider, country, terrain, device or model-selection history." ;
    dcterms:license "CC BY 4.0" ;
    dcterms:accessRights "openly licensed, but gitignored here: tracks start at the riders' home addresses, so no derived geometry is published — cite the deposit DOI" ;
    schema:spatialCoverage "Western Europe" .

:D_pool_35 a :Dataset ; rdfs:label "D3–D5 pool" ;
    prov:wasDerivedFrom :D3, :D4, :D5 ;
    rdfs:comment "The paper's headline pool. D2 excluded (overlaps D5); D6 deliberately excluded." .

:D_pool_36 a :Dataset ; rdfs:label "D3–D6 pool" ;
    prov:wasDerivedFrom :D3, :D4, :D5, :D6 ;
    rdfs:comment "In the frozen era this was reported BESIDE the D3–D5 headline pool, never replacing it (adding D6 lowers the pooled error only because D6 is the best-performing corpus). Since Entry 52 it IS paper 1's evaluation population — D1/D2 excluded as re-processings of D5 — walked at 2,039 rides by e52_build and split 1,734 train / 305 test, once, at seed 48." .

# Auxiliary (non-ride) inputs — the DEM/routing thread
:DEM_IGC   a :Dataset ; rdfs:label "IGC-SP 5 m raster" ; dcterms:description "The elevation source Simujaules deploys." .
:DEM_FABDEM a :Dataset ; rdfs:label "FABDEM 30 m" .
:OSM       a :Dataset ; rdfs:label "OpenStreetMap / Overpass" ;
    rdfs:comment "Request geometry sent to Overpass never derives from ride endpoints." .

# ---------------------------------------------------------------------------
# P — the parameter classes
# ---------------------------------------------------------------------------

:P_ag a :ParameterClass ; rdfs:label "P_{a,g} assumed-global" ;
    dcterms:description "The frozen protocol: one literature-typical set for every ride and every corpus — Crr 0.008, CdA 0.40, ρ 1.13, k_eff 0.98, wind 0, m 78 kg." .

:P_ar a :ParameterClass ; rdfs:label "P_{a,r} assumed-per-ride" ;
    dcterms:description "Condition-informed judgment: logged mass, judged Crr / CdA / density / wind, hand-chosen ε. The calibration arm only." .

:P_fr a :ParameterClass ; rdfs:label "P_{f,r} fitted-per-ride" ;
    dcterms:description "Constants inverted from the scored ride's own segments — partially in-sample by construction." .

:P_fp a :ParameterClass ; rdfs:label "P_{f,p} fitted-per-person" ;
    dcterms:description "One value per rider, inverted from that rider's own sustained climbs, then frozen across their rides." .

# Overrides carried by the `·` operator
:ov_m       a prov:Entity ; rdfs:label "m — implied total mass" ;
    rdfs:comment "Inverted from the sustained-climb energy balance. NEVER frozen as a harness literal: m·g is the identified product, so it moves with G (the Entry-27 lesson)." .
:ov_crr     a prov:Entity ; rdfs:label "C_rr" .
:ov_cda     a prov:Entity ; rdfs:label "C_dA" .
:ov_cda_reg a prov:Entity ; rdfs:label "C_dA^reg — regime-consistent aero" ;
    rdfs:comment "On D2 its median 0.62 is a stop-go TOTAL-LOSS coefficient, not drag: read that column as a regime signature." .
:ov_eps     a prov:Entity ; rdfs:label "ε" .

# ---------------------------------------------------------------------------
# F — the transformers
# ---------------------------------------------------------------------------

:eps_coast a prov:Entity ; rdfs:label "ε_coast(s) = min(1, (α/β)/s)" ; rdfs:comment "The coasting limit: what ε would be if the rider never pedalled downhill." .
:eps0 a prov:Entity ; rdfs:label "ε₀ — frozen constant deficit (0.13)" ; :epsilonFamily "deficit" .
:eps1 a prov:Entity ; rdfs:label "ε₁ — rider constant deficit" ; rdfs:comment "Dropped before Entry 47's contest." .
:eps2 a prov:Entity ; rdfs:label "ε₂ — grade-inverse deficit k/s̄, k = 0.0051 (eq. 8)" ;
    rdfs:comment "Domain-limited: k/s̄ exceeds 1 below s̄ ≈ 0.51%, and it was only TESTED at s̄ ≥ 3%." .
:eps3 a prov:Entity ; rdfs:label "ε₃ — encounter-fraction deficit a + bφ" .
:eps_f a prov:Entity ; rdfs:label "ε_f — flat constant 0.20" ; rdfs:comment "Selected on D2: its D2 cells are in-sample and starred." .
:eps_d a prov:Entity ; rdfs:label "ε_d — dynamic, geometry-derived: ε_coast(s) − δ" .

:F_base a :Model ; rdfs:label "F_base — forward-dynamics simulation" ;
    dcterms:description "Distance-marching force balance with per-regime pedal power and a safe-speed brake cap. A PEER of F1–F4 in every table, not the reference: all forms are scored against measured leg energy." ;
    rdfs:comment "Conserves energy by construction (semi-implicit KE update); the conservation residual is asserted ≤ 1e-6 on every compare.py run." .

:F1 a :Model ; rdfs:label "F1" .
:F2 a :Model ; rdfs:label "F2" .
:F3 a :Model ; rdfs:label "F3 — E ≈ α·x + β·(h₊ − ε·h₋)" ;
    rdfs:comment "The champion closed form; the paper's headline parity is F3·ε_d against F_base." .
:F4 a :Model ; rdfs:label "F4 — F3 with the scalar c" ;
    rdfs:comment "c is non-transferable: it belongs to the elevation source, not to cycling (sharpest evidence on D6)." .

:F_v2edge a :Model ; rdfs:label "v2Edge — the per-edge realisation Simujaules deploys" ;
    rdfs:comment "Grade-local ε(s), aero gated off climbs, k_s scaling β only, dead max(0,·) clamp. Mirrored in three places (Python r1d_v2_edge, the applet, energy-worker.js) — a change lands in all." .

:F_invert   a :Estimator ; rdfs:label "per-ride/per-person physics inversion (m̂, Ĉrr, ĈdA)" .
:F_epsmeas  a :Estimator ; rdfs:label "ε from the measured descent balance" ;
    rdfs:comment "Uses the MEASURED flat speed, never flat_eq_speed — otherwise a parameter mismatch inflates α and lies about ε." .
:F_occupancy a :Estimator ; rdfs:label "descent pedalling occupancy / intensity" .
:F_time     a :Model ; rdfs:label "time model x* = x + k₊h₊ − k₋h₋" ;
    rdfs:comment "Not part of paper 1 — its own piece." .

# ---------------------------------------------------------------------------
# I — the inputs actually evaluated
# ---------------------------------------------------------------------------

:i_d1_informed a :Input ; rdfs:label "(D₁, P_{a,r})" ; :dataset :D1 ; :parameters :P_ar .
:i_d1_frozen   a :Input ; rdfs:label "(D₁, P_{a,g})" ; :dataset :D1 ; :parameters :P_ag .
:i_d2_frozen   a :Input ; rdfs:label "(D₂, P_{a,g})" ; :dataset :D2 ; :parameters :P_ag .
:i_d3_frozen_m a :Input ; rdfs:label "(D₃, P_{a,g} · P_{f,p}(m))" ; :dataset :D3 ; :parameters :P_ag ; :override :ov_m .
:i_d4_frozen_m a :Input ; rdfs:label "(D₄, P_{a,g} · P_{f,p}(m))" ; :dataset :D4 ; :parameters :P_ag ; :override :ov_m .
:i_d5_frozen_m a :Input ; rdfs:label "(D₅, P_{a,g} · P_{f,p}(m))" ; :dataset :D5 ; :parameters :P_ag ; :override :ov_m .
:i_d6_frozen_m a :Input ; rdfs:label "(D₆, P_{a,g} · P_{f,p}(m))" ; :dataset :D6 ; :parameters :P_ag ; :override :ov_m ;
    rdfs:comment "D6's masses are PUBLISHED, so the inversion is graded against four known values rather than assumed. The published values are used for grading only, never fed back." .
:i_d34_fitted  a :Input ; rdfs:label "(D₃∪D₄, P_{a,g} · P_{f,p}(m, C_rr, C_dA))" ; :dataset :D3, :D4 ;
    :parameters :P_ag ; :override :ov_m, :ov_crr, :ov_cda .
:i_all_perride a :Input ; rdfs:label "(D₁..D₅, P_{a,g} · P_{f,r}(m, C_rr, C_dA))" ;
    :dataset :D1, :D2, :D3, :D4, :D5 ; :parameters :P_ag ; :override :ov_m, :ov_crr, :ov_cda .
:i_all_reg     a :Input ; rdfs:label "(D₁..D₅, P_{a,g} · P_{f,r}(m, C_rr, C_dA^reg))" ;
    :dataset :D1, :D2, :D3, :D4, :D5 ; :parameters :P_ag ; :override :ov_m, :ov_crr, :ov_cda_reg .
:i_d6_perride  a :Input ; rdfs:label "(D₆, P_{a,g} · P_{f,r}(m, C_rr, C_dA))" ; :dataset :D6 ;
    :parameters :P_ag ; :override :ov_m, :ov_crr, :ov_cda .
:i_dem         a :Input ; rdfs:label "(D₁..D₅ routes, DEM profiles)" ; :dataset :D5, :DEM_IGC, :DEM_FABDEM .

# ---------------------------------------------------------------------------
# The harness runs (activities) and O — the per-ride outputs
#
# Every :cardinality is the row count of the emitted CSV as of 2026-07-30.
# Outputs live in data/results/ and are gitignored: rows carry ride names,
# dates and per-ride energies tied to private activities.
# ---------------------------------------------------------------------------

:h_compare a prov:Activity ; p-plan:correspondsToStep "src/harness/compare.py" ; prov:used :i_d1_informed .
:o_model_comparison a :Output ; dcterms:identifier "model_comparison.csv" ;
    prov:wasGeneratedBy :h_compare ; :input :i_d1_informed ;
    :transformer :F1, :F2, :F3, :F4, :F_base ; :cardinality 44 ;
    :selection "the 44 power-metered longões" ;
    rdfs:comment "Also asserts the conservation residual ≤ 1e-6." .

:h_longoes_frozen a prov:Activity ; p-plan:correspondsToStep "src/harness/longoes_frozen.py" ; prov:used :i_d1_frozen .
:o_longoes_frozen a :Output ; dcterms:identifier "longoes_frozen.csv" ;
    prov:wasGeneratedBy :h_longoes_frozen ; :input :i_d1_frozen ;
    :transformer :F1, :F2, :F3, :F4, :F_base ; :cardinality 44 ;
    :selection "the same 44 rides as :o_model_comparison — the blind half of Table 2, so the informed→blind shift reads straight down" .

:h_censo a prov:Activity ; p-plan:correspondsToStep "src/harness/censo_compare.py" ; prov:used :i_d2_frozen .
:o_censo a :Output ; dcterms:identifier "censo_comparison.csv" ;
    prov:wasGeneratedBy :h_censo ; :input :i_d2_frozen ;
    :transformer :F1, :F2, :F3, :F4, :F_base ; :cardinality 69 ;
    :selection "parse + power; the published statistics filter further to dataOK = true (62 clean)" ;
    rdfs:comment "69 scored rows, 62 of them dataOK — and Table 1's |D| = 62 IS that clean count, so the published corpus size is itself post-selection. The 7 extra rows are flagged, not lost: they carry results and are excluded by the statistic, not the harness." .

:h_ppaz a prov:Activity ; p-plan:correspondsToStep "src/harness/ppaz_compare.py" ; prov:used :i_d3_frozen_m .
:o_ppaz a :Output ; dcterms:identifier "ppaz_comparison.csv" ;
    prov:wasGeneratedBy :h_ppaz ; :input :i_d3_frozen_m ;
    :transformer :F1, :F2, :F3, :F4, :F_base ; :cardinality 441 ;
    :selection "parse + power + per-corpus filters (§2.3)" ;
    rdfs:comment "Sensitivity runs suffix their own CSV (bem.env_suffix: PPAZ_M70, PPAZ_M78, the fitted triple) so a sweep can never overwrite the canonical file." .

:h_jaam a prov:Activity ; p-plan:correspondsToStep "src/harness/jaam_compare.py" ; prov:used :i_d4_frozen_m .
:o_jaam a :Output ; dcterms:identifier "jaam_comparison.csv" ;
    prov:wasGeneratedBy :h_jaam ; :input :i_d4_frozen_m ;
    :transformer :F1, :F2, :F3, :F4, :F_base ; :cardinality 219 ; :selection "parse + power + per-corpus filters (§2.3)" .

:h_danlessa a prov:Activity ; p-plan:correspondsToStep "src/harness/danlessa_compare.py" ; prov:used :i_d5_frozen_m .
:o_danlessa a :Output ; dcterms:identifier "danlessa_comparison.csv" ;
    prov:wasGeneratedBy :h_danlessa ; :input :i_d5_frozen_m ;
    :transformer :F1, :F2, :F3, :F4, :F_base ; :cardinality 636 ;
    :selection "parse + power; published population is the 621 with dataOK" ;
    rdfs:comment "Funnel: 3,219 export files -> inventory (sport=ride + power) -> 636 scored -> 621 clean, which is Table 1's |D|. The 15 flagged rides differ from the clean ones on TWO axes at once — median cadence coverage 0.76 vs 1.00 AND median smoothed ascent 19.9 vs 8.3 m/km — so the harness comment calling them power dropouts is incomplete: the floor is largest exactly where the climbing is." .

:h_skc a prov:Activity ; p-plan:correspondsToStep "src/harness/skc_compare.py" ; prov:used :i_d6_frozen_m .
:o_skc a :Output ; dcterms:identifier "skc_comparison.csv" ;
    prov:wasGeneratedBy :h_skc ; :input :i_d6_frozen_m ;
    :transformer :F1, :F2, :F3, :F4, :F_base ; :cardinality 743 ;
    :selection "parse + power + ≥ 3 km + non-virtual (Zwift, FIT manufacturer 260, excluded)" ;
    rdfs:comment "1,053 parseable → 743 emitted → 740 published clean. Three separate populations behind one corpus label." .

:h_skc_invert a prov:Activity ; p-plan:correspondsToStep "src/harness/skc_invert.py" ; prov:used :i_d6_perride .
:o_skc_invert a :Output ; dcterms:identifier "skc_invert.csv" ;
    prov:wasGeneratedBy :h_skc_invert ; :input :i_d6_perride ;
    :transformer :F_invert, :F3 ; :cardinality 743 ;
    :selection "as :o_skc — arm A, regime-consistent physics" ;
    rdfs:comment "Wind is deliberately 0: the weather fetch would key on centroids derived from third-party riders' home addresses." .
:o_skc_occupancy a :Output ; dcterms:identifier "skc_descent_occupancy.csv" ;
    prov:wasGeneratedBy :h_skc_invert ; :transformer :F_occupancy ; :cardinality 2193 ;
    :dataset :D1, :D2, :D3, :D4, :D5, :D6 ;
    :selection "every corpus, physics-free — arm B" ;
    rdfs:comment "2,193 rows across all corpora INCLUDING the D1⊂D5 and D2∩D5 overlaps: this is a count of evaluations, never of riders or of unique rides." .

:h_skc_eps a prov:Activity ; p-plan:correspondsToStep "src/harness/skc_eps_vs_pedal.py" .
:o_skc_eps a :Output ; dcterms:identifier "skc_eps_vs_pedal.csv" ;
    prov:wasGeneratedBy :h_skc_eps ; :transformer :F_occupancy, :F_epsmeas ; :cardinality 1038 ;
    :selection "rides with s̄ ≥ 3% — arm C, Spearman(pedal ratio, deficit) at ride level" .

:h_invert a prov:Activity ; p-plan:correspondsToStep "src/harness/perride_invert.py" ; prov:used :i_all_perride .
:o_perride_invert a :Output ; dcterms:identifier "perride_invert.csv" ;
    prov:wasGeneratedBy :h_invert ; :input :i_all_perride, :i_all_reg ;
    :transformer :F_invert, :F1, :F2, :F3, :F4, :F_base ; :cardinality 1409 ;
    :selection "parse + power + ≥ 3 km" ;
    rdfs:comment "Import-safe: the Entry-43 arm A imports it. Feeds BOTH Table 5 (ĈdA) and Table 6 (ĈdA^reg) — one O, two statistics." .

:h_eps_hyp a prov:Activity ; p-plan:correspondsToStep "src/harness/eps_hypothesis.py" .
:o_eps_hypothesis a :Output ; dcterms:identifier "eps_hypothesis.csv" ;
    prov:wasGeneratedBy :h_eps_hyp ; :input :i_d1_frozen ; :transformer :F_epsmeas ; :cardinality 44 .

:h_eps_sp a prov:Activity ; p-plan:correspondsToStep "src/harness/eps_sp_test.py" .
:o_eps_sp a :Output ; dcterms:identifier "eps_sp.csv" ;
    prov:wasGeneratedBy :h_eps_sp ; :input :i_d2_frozen ; :transformer :F_epsmeas ; :cardinality 59 .

:h_time a prov:Activity ; p-plan:correspondsToStep "src/harness/time_compare.py" .
:o_time a :Output ; dcterms:identifier "time_comparison.csv" ;
    prov:wasGeneratedBy :h_time ; :transformer :F_time ; :cardinality 542 ;
    :dataset :D1, :D3 ; :selection "corpus column splits it; the published endpoint is the ppaz subset" ;
    rdfs:comment "Its implied masses must be refreshed whenever G or the inversion changes." .

:h_cda a prov:Activity ; p-plan:correspondsToStep "src/harness/cda_estimate.py" .
:o_cda a :Output ; dcterms:identifier "cda_estimate.csv" ; prov:wasGeneratedBy :h_cda ;
    :transformer :F_invert ; :cardinality 3 ; :selection "per rider, not per ride — one of the few outputs whose grain is P, not D" .
:o_param_fit a :Output ; dcterms:identifier "param_fit.csv" ; :transformer :F_invert ; :cardinality 4 ;
    p-plan:correspondsToStep "src/harness/param_fit.py" ;
    rdfs:comment "Its pts_with_geo keeps lat/lon — the one point-builder that is NOT the shared pts_from_fit." .

:h_sweep a prov:Activity ; p-plan:correspondsToStep "src/harness/param_sweep.py" .
:o_param_sweep a :Output ; dcterms:identifier "param_sweep.csv" ; prov:wasGeneratedBy :h_sweep ;
    :dataset :D2, :D3, :D4, :D5 ; :transformer :F3 ; :cardinality 432 ;
    :selection "pre-registered CdA × Crr × ρ grid — grain is (corpus × combination), NOT per ride" ;
    rdfs:comment "Exact order-statistic CIs, a gate-checked deviation from the bootstrap convention. Self-gates m̂ and all 16 anchor medians on every full run." .
