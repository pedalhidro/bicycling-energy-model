# ---------------------------------------------------------------------------
# T — the published statistics
# ---------------------------------------------------------------------------

:gate a prov:Activity ; p-plan:correspondsToStep "src/harness/bootstrap_ci.py" ;
    dcterms:description "The gate battery: recomputes every published median AND its 95% band from the O's, and exits non-zero on failure. B = 10⁴, seeds 42/43, stratified within corpus/rider." ;
    rdfs:comment "A gate is only as good as its denominator: the §3j scope gate originally hardcoded the same wrong 2,155 the prose used, so it certified the error instead of catching it. Gates now recompute denominators from the CSV." .

:tab2 a :Statistic ; rdfs:label "Table 2 — calibration scoreboard" ;
    prov:wasDerivedFrom :o_model_comparison, :o_longoes_frozen ; prov:wasGeneratedBy :gate ; :gatedBy :gate .
:tab3 a :Statistic ; rdfs:label "Table 3 — frozen constants on every non-calibration corpus" ;
    prov:wasDerivedFrom :o_censo, :o_ppaz, :o_jaam, :o_danlessa, :o_skc ; :gatedBy :gate ;
    rdfs:comment "Column n is |O|, not |D|. Its D3–D5 pool is 1,366 evaluations — the denominator that the 52%-vs-69% scope error got wrong by substituting 2,155." .
:tab4 a :Statistic ; rdfs:label "Table 4 — fitted versus assumed physics" ;
    prov:wasDerivedFrom :o_ppaz, :o_jaam ; :input :i_d34_fitted ; :gatedBy :gate .
:tab5 a :Statistic ; rdfs:label "Table 5 — per-ride inverted physics" ;
    prov:wasDerivedFrom :o_perride_invert, :o_skc_invert ; :gatedBy :gate ;
    rdfs:comment "Its populations differ from Table 3 on an UNCHANGED |D| — the caption states each |O| for exactly that reason." .
:tab6 a :Statistic ; rdfs:label "Table 6 — regime-consistent aero" ;
    prov:wasDerivedFrom :o_perride_invert, :o_skc_invert ; :gatedBy :gate .
:fig5 a :Statistic ; rdfs:label "Figure 5 — every São Paulo route on one map" ;
    prov:wasDerivedFrom :o_model_comparison, :o_censo, :o_ppaz, :o_jaam, :o_danlessa ;
    rdfs:comment "D6 deliberately absent (home addresses). First and last 1.5 km of every ride withheld, so its legend counts match no table's |O|." .
:eq8 a :Statistic ; rdfs:label "Equation (8) — the grade-inverse deficit k/s̄" ;
    prov:wasDerivedFrom :o_e45_paper ; :epsilonForm :eps2 ; :gatedBy :gate ;
    rdfs:comment "k is refitted from the CSV by the gate, never hardcoded — an earlier double-rounding shipped 0.131 at a reverse-engineered s̄ = 3.9% labelled as D1's typical descent (real median 3.80% → 0.133)." .
:headline a :Statistic ; rdfs:label "The headline parity: F3·ε_d 3.16% vs F_base 3.15% on D6's 740 rides" ;
    prov:wasDerivedFrom :o_skc ; :gatedBy :gate .

# Journal entries that a published output answers to. The prose in
# research/journal/MODEL_COMPARISON_JOURNAL.md remains authoritative.
:entry22 a :Statistic ; rdfs:label "Entry 22 — error bars for the headline medians" ; prov:wasGeneratedBy :gate .
