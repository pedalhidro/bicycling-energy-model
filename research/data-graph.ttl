:h_e45 a prov:Activity ; p-plan:correspondsToStep "src/harness/e45_ridelevel.py" .
:o_e45_paper a :Output ; dcterms:identifier "e45_ridelevel.paper.csv" ; prov:wasGeneratedBy :h_e45 ;
    :transformer :F_epsmeas ; :cardinality 1038 ;
    :epsilonForm :eps0, :eps2, :eps3 ;
    :selection "E45_TARGET=paper — the CLAMPED deficit ε_coast − ε_bal, s̄ ≥ 3%" ;
    rdfs:comment "The clamped/unclamped split is the single most error-prone thing in this repo: paper 1's published deficit is clamped (pooled median 0.13, k = 0.0051), the exact ledger identity is unclamped (0.253, k = 0.0099). Whichever quantity is measured, the constant MUST be fitted to that same quantity. Four wrong readings came from mixing them." .
:o_e45_ledger a :Output ; dcterms:identifier "e45_ridelevel.csv" ; prov:wasGeneratedBy :h_e45 ;
    :transformer :F_epsmeas ; :cardinality 1039 ;
    :selection "E45_TARGET=ledger — the UNCLAMPED ledger identity δ = E_legs,− / (β h₋)" .
