    prov:wasDerivedFrom :o_param_sweep, :o_param_sweep_canon .
:entry31 a :Statistic ; rdfs:label "Entry 31 — the D1 protocol correction, frozen re-run" ; prov:wasDerivedFrom :o_longoes_frozen .
:entry33 a :Statistic ; rdfs:label "Entry 33 — per-ride physics inversion" ; prov:wasDerivedFrom :o_perride_invert .
:entry34 a :Statistic ; rdfs:label "Entry 34 — the S-curve deficit" ; prov:wasDerivedFrom :o_scurve .
:entry35 a :Statistic ; rdfs:label "Entry 35 — the honest-physics residual" ; prov:wasDerivedFrom :o_e35 .
:entry36 a :Statistic ; rdfs:label "Entry 36 — ε₀ per dataset" ; prov:wasDerivedFrom :o_e36 .
:entry41 a :Statistic ; rdfs:label "Entry 41 — the law on planner DEM profiles" ; prov:wasDerivedFrom :o_e41 .
:entry42 a :Statistic ; rdfs:label "Entry 42 — the lumped ε_d" ; prov:wasDerivedFrom :o_e42 .
:entry43 a :Statistic ; rdfs:label "Entry 43 — the fifth rider set (D6) and its three amendment arms" ;
    prov:wasDerivedFrom :o_skc, :o_skc_invert, :o_skc_occupancy, :o_skc_eps .
:entry44 a :Statistic ; rdfs:label "Entry 44 — the S-curve reopened" ; prov:wasDerivedFrom :o_e44_cells, :o_e44_fits .
:entry45 a :Statistic ; rdfs:label "Entry 45 — the ride-level form contest" ;
    prov:wasDerivedFrom :o_e45_paper, :o_e45_ledger, :o_e45_flatseg .

:entry8  a :Statistic ; rdfs:label "Entry 8 — a closed form for ε from route geometry" ; prov:wasDerivedFrom :o_eps_hypothesis .
:entry10 a :Statistic ; rdfs:label "Entry 10 — is São Paulo's ε braking-driven? (no — it's a constant)" ; prov:wasDerivedFrom :o_eps_sp .
:entry13 a :Statistic ; rdfs:label "Entry 13 — the time model: ascent half holds, descent bridge does not" ;
    prov:wasDerivedFrom :o_time ; :gatedBy :gate ;
    rdfs:comment "Gated in the battery but deliberately OUT of paper 1 — the time model is its own piece." .
:entry15 a :Statistic ; rdfs:label "Entry 15 — independently estimating CdA, C_rr, mass and wind" ;
    prov:wasDerivedFrom :o_cda, :o_param_fit .
:entry17 a :Statistic ; rdfs:label "Entries 17–18 — the regime-decomposed closed form; v2Edge never clamps" ;
    prov:wasDerivedFrom :o_regime .
:entry19 a :Statistic ; rdfs:label "Entry 19 — v2Edge on the deployed IGC-SP 5 m raster vs a 30 m resample" ;
    prov:wasDerivedFrom :o_igc .
:entry20 a :Statistic ; rdfs:label "Entry 20 — can the deployed pipeline hit ±5% error / ±2% bias?" ;
    prov:wasDerivedFrom :o_goal ;
    rdfs:comment "Its anchor constants are carried by scale_trio.py — a re-run of this entry obliges a refresh there." .
:entry21 a :Statistic ; rdfs:label "Entry 21 — the resolution gap is a parameter problem, not a DEM problem" ;
    prov:wasDerivedFrom :o_scale, :o_igc, :o_goal ;
    rdfs:comment "Its scale prescription is what paper 3 cites through paper 2." .
:entry26 a :Statistic ; rdfs:label "Entry 26 — the direction ladder on real ride endpoints, and portals" ;
    prov:wasDerivedFrom :o_e26_grid, :o_e26_portals, :o_e26_detour .
:entry38 a :Statistic ; rdfs:label "Entries 38–40 — the deadband thread: τ*, the deconfounded sweep, roller recycling" ;
    prov:wasDerivedFrom :o_e38, :o_e39, :o_e40 ; :gatedBy :gate .
:verification a :Statistic ; rdfs:label "VERIFICATION_NOTES" ; prov:wasDerivedFrom :o_verify .

:dataOK a :Estimator ; rdfs:label "the dataOK plausibility flag: emp >= β·h₊(smoothed)" ;
    rdfs:comment "Measured pedalling energy must clear the gravitational potential energy of the climbing — the measurement-side counterpart of the engine invariant legE >= mg·h₊/k_eff. It fires on incomplete power streams AND on climb-heavy rides where the floor is largest; it is not a pure dropout filter. Note the floor uses the SMOOTHED ascent while the CSV's hplus column is RAW — reading the raw column against the floor overstates the miss." .

# --- Entry 47: deficit-form selection -------------------------------------

:P_fp_e47 a :ParameterClass ; rdfs:label "P_{f,p} via invert_physics" ;
    rdfs:comment "Steps 4-6 of the per-ride inversion, extracted from perride_invert.run_ride in Entry 47 so it has exactly one copy; verified behaviour-neutral by diffing a smoke run against the pre-refactor output." .

:F_select a :Estimator ; rdfs:label "deficit-form selection by BIC (Laplace)" ;
    rdfs:comment "argmin_delta BIC with b_hat = mean|Delta%| the Laplace MLE scale; DeltaBIC < 2 goes to the fewest parameters, so the incumbent is the default champion. Fits by LAD (argmin sum|r|) on a deterministic refining grid — no RNG, so the same answer on every machine." .

:i_d12_ag a :Input ; rdfs:label "(D₁∪D₂, P_{a,g})" ; :dataset :D1, :D2 ; :parameters :P_ag ;
    rdfs:comment "The frozen protocol as each corpus's PUBLISHED harness applies it: logged mass on D1 (longoes_frozen.py), the generic 78 kg on D2 (censo_compare.py). Copied rather than idealised." .
:i_d12_fr a :Input ; rdfs:label "(D₁∪D₂, P_{a,g} · P_{f,r}(m, C_rr, C_dA))" ;
    :dataset :D1, :D2 ; :parameters :P_ag ; :override :ov_m, :ov_crr, :ov_cda .

:o_e47 a :Output ; dcterms:identifier "e47_formselect.csv" ;
    p-plan:correspondsToStep "src/harness/e47_formselect.py" ;
    :input :i_d12_ag, :i_d12_fr ; :transformer :F3, :F_select ;
    :epsilonForm :eps0, :eps2, :eps3 ; :cardinality 2141 ;
    :selection "parse + power + >= 3 km + s_bar >= 3%; 48 on the calibration side (D1 22, D2 26) and 990 on D3-D6 — 1,038 in total, reproducing Entry 45's population ride for ride across all nine groups" ;
    rdfs:comment "|O| 2141 is the ROWS WRITTEN (every ride reaching the gate, gated or not, so the funnel is auditable); the contest populations are 48 and 990. Two s_bar definitions exist and disagree on 5 of 113 calibration rides — eps_cells' (what every published harness gates on, and what |O| = 48 was registered from) and eps_geom's (the profile the law reads). The champion is reported under both and does not move." .

:entry47 a :Statistic ; rdfs:label "Entry 47 — which deficit form? two pre-registered selections" ;
    prov:wasDerivedFrom :o_e47 ; :gatedBy :gate ;
    rdfs:comment "Calibration arms select eps_0 (the incumbent, 0 free parameters); the in-sample D3-D6 arms select eps_2 decisively (DeltaBIC 128.8 / 88.2). The disagreement is statistical power, not direction. Nothing published moved. Two unregistered findings: delta fitted on ENERGY does not recover the published constants (c = 0.044, k = 0.0020) while delta fitted on the DEFICIT does (c = 0.134, k = 0.0052 against the published 0.13 and 0.0051), because a free delta absorbs the law's positive bias instead of measuring descent pedalling; and DeltaBIC = 128.8 corresponds to 0.17 pp of median error, BIC scoring the MEAN absolute residual while every published statistic is a median." .

# --- Entry 46: the regime switch ------------------------------------------

:F_switch a :Transformer ; rdfs:label "the §3.3 regime switch" ;
    rdfs:comment "eps_d when s_bar >= 3%, eps_f = 0.20 otherwise. Registered in Entry 46, built in Entry 47's wake. Stated in paper 1 since the first draft and implemented by NO published harness — every published eps_d column applies the dynamic estimator to every ride, including the 52% of all scored rides below the threshold." .

:o_e46 a :Output ; dcterms:identifier "e46_switch.csv" ;
    p-plan:correspondsToStep "src/harness/e46_switch.py" ;
    :transformer :F_switch, :F3 ; :epsilonForm :eps0, :eps2, :eps_f ;
    :cardinality 2141 ;
    prov:wasDerivedFrom :o_e47 ;
    :selection "every ride Entry 47 built; 1,103 (52%) fall below the 3% gate — the population the switch acts on" ;
    rdfs:comment "A SECOND-ORDER output: O_46 = T(O_47), derived from an output rather than from a corpus. Legitimate because approximate() is exactly linear in eps, so Entry 47's stored E(0) and E(1) pin every eps in closed form — and it makes the two entries share a population by construction, which is what licenses the paired sign tests." .

:entry46 a :Statistic ; rdfs:label "Entry 46 — the regime switch, implemented" ;
    prov:wasDerivedFrom :o_e46 ; :gatedBy :gate ;
    rdfs:comment "The two parameter classes REVERSE the verdict: under frozen priors switching worsens the pooled median (5.08 -> 5.62), under per-ride inverted physics it improves it (5.51 -> 4.12). The bias column adjudicates — below 3%, eps_d is near-unbiased under frozen priors (+0.28) and badly biased under honest physics (-4.64), while eps_f = 0.20 is the reverse (+5.90, +0.11). So eps_d on flat rides ABSORBS the frozen CdA = 0.40 prior rather than measuring recovery: the median applied eps_d there is 0.544 against eps_f's 0.20. Section 3.3's rule is right; the frozen grid's sub-3% cells are accurate by cancellation. Registered P3 fails: unswitched, grade-inverse is better overall (4.83 vs 5.08), not worse." .

# --- Entry 48: formal equivalence (TOST) ----------------------------------

:F_tost a :Estimator ; rdfs:label "TOST on the difference of medians" ;
    rdfs:comment "Paired stratified bootstrap: BOTH engines' median |D%| from the SAME resample, so the interval carries the correlation between two engines that share every input. Differencing two independently-computed CIs would badly overstate the width. Equivalence iff the 90% CI of d falls inside ±1.0 pp — two one-sided tests at 0.05 each IS that containment, which is why the interval is 90% and not 95%. Seed 44: 42 and 43 carry the published |D%| and signed CIs, and reusing one would silently correlate this interval with those." .

:o_e48 a :Output ; dcterms:identifier "e48_equiv.csv" ;
    p-plan:correspondsToStep "src/harness/e48_equiv.py" ;
    :transformer :F_tost ; :cardinality 10 ;
    prov:wasDerivedFrom :o_model_comparison, :o_longoes_frozen, :o_censo,
        :o_ppaz, :o_jaam, :o_danlessa ;
    :selection "the ten registered comparisons; each population is EXACTLY the one behind the published bracket, with zero rides dropped for lacking a partner — a paired test needs both columns finite on the same ride, while the published medians filter each column independently" ;
    rdfs:comment "Grain is the COMPARISON, not the ride — one of the few outputs whose dimension is deliberately not D's. A second-order output: derived from the published per-ride outputs rather than from a corpus." .

:entry48 a :Statistic ; rdfs:label "Entry 48 — formal equivalence (TOST) for the parity claims" ;
    prov:wasDerivedFrom :o_e48 ; :gatedBy :gate ;
    rdfs:comment "Four equivalent, six inconclusive, none outside the margin. Both pooled rows are formally equivalent within ±1.0 pp (D3+D4 [-0.90,-0.33], D3-D5 [-0.55,-0.07]), upgrading the headline transfer claim from a failure-to-reject. D1 is inconclusive at n = 44 on both protocols, as registered. Five of six inconclusive verdicts are inconclusive on the side where the LAW BEATS the simulation — D3's CI [-1.56,-0.63] is wholly negative — so reading 'inconclusive' as a weakness of the law is backwards. The exception is D2 · F3, whose interval [-0.04,+2.18] allows the law being 2.2 pp WORSE on urban stop-go riding; that parity sentence was softened rather than defended." .

# ===========================================================================
# Entries 49–72 (2026-07-30 → 2026-08-08): the deficit demoted, the A-chain,
# the F5 program, and the doctrine reaching papers 2–3.
# Every :cardinality below counted from data/results/ on 2026-08-08.
# ===========================================================================

# --- New parameter classes and ε entities ----------------------------------

:P_fr_rider a :ParameterClass ; rdfs:label "P_{f,r}^{rider} — per-ride inversion with rider-median fallbacks" ;
    dcterms:description "Entry 57: each rider's own train-half median replaces every global prior (Crr 0.008, CdA 0.400), so no ride carries an assumed constant and no ride is dropped. Partial pooling: ride-level where the ride supports it, rider-level where it cannot — the direction Entry 53 pointed to." ;
    rdfs:comment "The canonical class from Entry 57 on: e52_build's unsuffixed cache carries it (E52_FALLBACK=rider default)." .

:eps5 a prov:Entity ; rdfs:label "δ₅ — affine deficit ε_coast·k₁ + k₂ (Entry 49)" ;
    rdfs:comment "UNIDENTIFIED: slope CI [−1.727, +0.536] — k₁ and k₂ trade off. Dominated on BIC by the flat constant it nests. Label kept as given (the family runs ε₀–ε₃; renaming would disagree with the request that created it)." .

:eps_flat a prov:Entity ; rdfs:label "ε — the published A-chain flat constant (0.2939)" ;
    rdfs:comment "Replaces ε_d in paper 1 since Entries 50–51 (the dynamic estimator lost to a constant on held-out rides). Fitted under mean |log(Ê/E)| — Entry 51's 0.2278 was median-|Δ%|-optimal on the same rides; the LOSS moved it, not the data. Regional pools since Entry 60: 0.2385 (D3–D5) / 0.3712 (D6), a split Entry 61 showed is terrain, not people." .

# --- New transformers ------------------------------------------------------

:F_sobol a :Estimator ; rdfs:label "Saltelli/Sobol variance decomposition over (m, C_dA, C_rr, ε)" ;
    rdfs:comment "Affordable because F1–F4 reduce per ride to precomputed geometry aggregates; ε enters exactly linearly. Ranks depend on the assumed boxes — the registered verdict had to hold under two parameterisations, and did." .

:F_describe a :Estimator ; rdfs:label "descriptive per-ride aggregation (Entry 62 — fits nothing, gates nothing)" ;
    rdfs:comment "Its HR column forced the parser change that bumped ride.py's _CACHE_SCHEMA 1 → 2 (FIT record field 3); cadence and HR are Python-only, the one intentional gap in the applet-mirror rule." .

:F_drift a :Estimator ; rdfs:label "closure-pair drift probe (Entry 66)" ;
    rdfs:comment "Drift is a function of time at a fixed place; terrain of place — so same-cell (10 m) point pairs ≥ 10 min apart measure a ride's own elevation drift with no DTM. Place-shaped errors (FABDEM bias, georeferencing, GPS-slope leakage) cancel from a same-place difference by construction." .

:F5 a :Model ; rdfs:label "F5 — F3(τ_n) minus the KE-buffer valley toll" ;
    rdfs:comment "T = Σ_valleys min(D, H, max(0, h_KE − 2τ_n)) subtracted from both h̃₊ and h̃₋: the momentum carried out of each descent foot, computed not fitted. Exact surgery on F3's components (linear in ε, so the E52 two-point cache pins the family); gate: F5(v_b = 0) ≡ F3(τ_n) at 0 kJ on all 2,039 rides. Fitted v_b rails at never-brake — a finding (the cap doesn't bind at these grades), not a fit." .

:F5f a :Model ; rdfs:label "F5f — F5 with v_b frozen at never-brake (1 fitted parameter: ε)" ;
    rdfs:comment "Wins Entry 64's 1-SE selection at τ_n = 2 over the fitted-τ F3; AIC still prefers F3 (Entry 49's precedent: held-out/CV primary, IC reported). Entry 68: its CV declines MONOTONICALLY in τ_n — the floor is load-bearing, so the one-parameter claim is as strong as the floor's external justification." .

:F5m a :Model ; rdfs:label "F5m — F5 with v_b measured per ride (95th-pct descent speed)" ;
    rdfs:comment "Telemetry, not a parameter: corpus median v̂_b = 46.5 km/h. The best LORO transferrer of Entry 64 (169/302, sign p = 0.044)." .

:F5p a :Model ; rdfs:label "F5p — F5 with the floor pinned per corpus by measured drift, v_b frozen; ε the ONLY fitted parameter" ;
    rdfs:comment "Each rider group's floor = its median closure-pair drift (e66_drift.csv) snapped to the τ grid — parameter-class telemetry, like m̂. Entry 69: matches F3's CV, ages ~4× better, best rider transfer of the program (−0.27 pp, p = 0.0001). Pins are READ from the producing CSV, never hardcoded." .

# --- New inputs ------------------------------------------------------------

:i_d36_fr a :Input ; rdfs:label "(D₃..D₆, P_{f,r})" ;
    :dataset :D3, :D4, :D5, :D6 ; :parameters :P_fr ; :override :ov_m, :ov_crr, :ov_cda_reg ;
    rdfs:comment "The A-chain input as registered (Entry 52), regime-consistent aero the default since Entry 55. What the label actually contains is COUNTED and published: Crr at the 0.008 prior on 77% of rides, CdA at the 0.400 rail on 27% — until Entry 57 replaced both fallbacks." .

:i_d36_fr_rider a :Input ; rdfs:label "(D₃..D₆, P_{f,r}^{rider})" ;
    :dataset :D3, :D4, :D5, :D6 ; :parameters :P_fr_rider ; :override :ov_m, :ov_crr, :ov_cda_reg ;
    rdfs:comment "The canonical input from Entry 57 on: every constant originates in the rider's own telemetry." .

:i_e61_synth a :Input ; rdfs:label "(200 real route geometries from D₃–D₅ and D₆, synthetic physics grid)" ;
    :dataset :D_pool_35, :D6 ;
    rdfs:comment "100 routes per region, deterministic by seed; ground truth is the canonical engine under a swept 3⁶ physics/behaviour grid. Behaviour is FIXED by the sweep — the same synthetic rider over both regions — so a surviving regional ε gap can only be terrain." .

:i_e71_dem a :Input ; rdfs:label "(D₃..D₆ routes, IGC/FABDEM profiles · A-chain physics)" ;
    :dataset :D3, :D4, :D5, :D6, :DEM_IGC, :DEM_FABDEM ; :parameters :P_fr_rider ;
    rdfs:comment "Entry 71's MODE walk: paper 1's population with D5's travel rides KEPT (bbox skip demoted to a per-ride igc_ok flag) and D6 vs FABDEM+baro; physics joined from the A-chain cache (100% join verified), wind 0 by that iterator's registration." .

